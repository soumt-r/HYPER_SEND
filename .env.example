# Copy to .env on the server: cp .env.example .env
# Read by docker compose, both for variable interpolation and as the app container's env_file

# Image to run (pushed by GitHub Actions)
HYPER_SEND_IMAGE=ghcr.io/soumt-r/hyper_send:latest

# Postgres password (letters and digits only — it goes into the DATABASE_URL)
POSTGRES_PASSWORD=change-me

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Admin page access email
ADMIN_EMAIL=

# Contact for reports and privacy requests (shown in the footer, privacy policy, and report link)
CONTACT_EMAIL=

# Disk protection: refuse uploads that would leave less free disk than this (default 2)
MIN_FREE_DISK_GB=2
# Optional cap on the total size of all stored files; leave empty for no cap
STORAGE_LIMIT_GB=
