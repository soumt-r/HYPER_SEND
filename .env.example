# Copy to .env on the server: cp .env.example .env
# Read by docker compose, both for variable interpolation and as the app container's env_file

# Image to run (pushed by GitHub Actions)
HYPER_SEND_IMAGE=ghcr.io/soumt/hyper-send:latest

# Postgres password (letters and digits only — it goes into the DATABASE_URL)
POSTGRES_PASSWORD=change-me

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Admin page access email
ADMIN_EMAIL=
